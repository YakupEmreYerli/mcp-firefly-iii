# Copy this file to .env and fill in the two required values.
# .env is git-ignored; never commit a real token.

# ── Required ───────────────────────────────────────────────────────────────
# Your Firefly III API base URL. The trailing /api/v1 is required.
FIREFLY_API_URL=https://your-firefly-instance.com/api/v1

# Personal Access Token:
# Firefly III → Options → Profile → OAuth → "Create New Personal Access Token"
FIREFLY_API_TOKEN=your-token-here

# ── Operation mode ─────────────────────────────────────────────────────────
# false → 3 meta-tools (firefly_execute / firefly_list_operations /
#         firefly_get_schema) reach all 139 operations. Recommended: most MCP
#         clients degrade past ~40 tools.
# true  → every operation becomes its own tool (139 of them).
FIREFLY_DIRECT_MODE=false

# Entities to enable. "all" covers every entity the server knows; run
# firefly_list_operations to see them. Or list a subset, comma-separated,
# e.g. transaction,account,budget,summary,insight
FIREFLY_ENABLED_ENTITIES=all

# ── Safety ─────────────────────────────────────────────────────────────────
# true → create/update/delete operations are refused and hidden from the tool
#        catalogue; only reads get through. Worth turning on for any session
#        that is only meant to answer questions about live financial data.
FIREFLY_READ_ONLY=false

# Finer than the on/off above, when you want one. Either a preset —
#   read    reads only, same as FIREFLY_READ_ONLY=true
#   safe    reads, creates and updates, but nothing that cannot be undone
#   full    everything (the default when this is unset)
# — or a per-entity list, where `*` sets the fallback:
#   FIREFLY_PERMISSIONS=transaction:safe;account:read;rule:none;*:read
# Whichever of this and FIREFLY_READ_ONLY is stricter wins. A clause that
# cannot be read is dropped rather than widened, so a typo fails closed.
FIREFLY_PERMISSIONS=

# Return results as MCP structuredContent instead of JSON-in-a-text-block.
# Off by default. The spec suggests sending both for older clients, but these
# responses are large — account.list is 18 KB on a small instance — so doing
# that would hand back much of what the response trimming saves. This server
# sends one or the other, never both: turn it on if your client understands
# structuredContent, leave it off otherwise.
MCP_STRUCTURED_OUTPUT=false

# Reserved. Read into the config but not consumed yet — the server has no
# logging layer, so setting this currently changes nothing.
FIREFLY_LOG_LEVEL=INFO

# Set to true only for a local instance with a self-signed certificate.
FIREFLY_DISABLE_SSL_VERIFY=false

# ── Optional remote MCP HTTP mode ─────────────────────────────────────────
# Required by `npm run start:http`; never expose this endpoint without a token.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_TOKEN=replace-with-a-long-random-token
