# Copy this file to .env and fill in the two required values.
# .env is git-ignored; never commit a real token.

# ── Required ───────────────────────────────────────────────────────────────
# Your Firefly III instance. A bare domain is enough — https:// and /api/v1
# are filled in. Give the full URL instead if yours sits behind a subpath, on
# a custom port, or on plain http:
#   FIREFLY_API_URL=https://your-server:8080/firefly/api/v1
FIREFLY_API_URL=your-firefly-instance.com

# Personal Access Token:
# Firefly III → Options → Profile → OAuth → "Create New Personal Access Token"
FIREFLY_API_TOKEN=your-token-here

# ── Safety ─────────────────────────────────────────────────────────────────
# How far the assistant may go. Unset means everything. Either a preset —
#   read    reads only; every write is refused and hidden from the catalogue
#   safe    reads, creates and updates, but nothing that cannot be undone
#   full    everything (the default when this is unset)
# — or a per-entity list, where `*` sets the fallback:
#   FIREFLY_PERMISSIONS=transaction:safe;account:read;rule:none;*:read
# Naming an entity `:none` hides it entirely. A clause that cannot be read is
# dropped rather than widened, so a typo fails closed.
FIREFLY_PERMISSIONS=

# Return results as MCP structuredContent instead of JSON-in-a-text-block.
# Off by default. The spec suggests sending both for older clients, but these
# responses are large — account.list is 18 KB on a small instance — so doing
# that would hand back much of what the response trimming saves. This server
# sends one or the other, never both: turn it on if your client understands
# structuredContent, leave it off otherwise.
MCP_STRUCTURED_OUTPUT=false

# ── OAuth (HTTP mode) ───────────────────────────────────────────────────────
# Leave both empty to keep bearer-token auth, which is what MCP_HTTP_TOKEN is.
# Set them to accept tokens from an OAuth 2.1 authorization server instead —
# what a client like Claude's web connector expects, since it has nowhere to
# put a static token.
#
# Set MCP_AUTH_PASSWORD to enable the embedded OAuth 2.1 authorization server.
# It provides DCR, PKCE, login and consent without another identity service.
# Use at least 12 characters. Do not set it together with
# MCP_AUTHORIZATION_SERVERS.
MCP_AUTH_PASSWORD=
# Persistent directory for the embedded ES256 key, clients and refresh-token
# hashes. In Docker this path must be backed by a volume.
MCP_AUTH_STATE_DIR=/data/firefly-mcp-auth
#
# The canonical address a client reaches this server at. A token's audience is
# bound to it, so it must match exactly. A bare domain is enough — https:// is
# filled in. Subpaths are not supported because Firefly III's Laravel Passport
# already owns the /oauth/* paths; use a separate hostname.
MCP_RESOURCE_URL=
# Used only when MCP_AUTH_PASSWORD is empty: comma-separated issuers whose
# tokens are accepted, compared to a token's `iss` by exact string. The two
# auth modes are exclusive.
MCP_AUTHORIZATION_SERVERS=
#
# Scopes map onto the three execution surfaces:
#   firefly:read         firefly_query
#   firefly:write        + firefly_mutate
#   firefly:destructive  + firefly_destructive
# Broader implies narrower, so one scope is enough.

# Reserved. Read into the config but not consumed yet — the server has no
# logging layer, so setting this currently changes nothing.
FIREFLY_LOG_LEVEL=INFO

# Set to true only for a local instance with a self-signed certificate.
FIREFLY_DISABLE_SSL_VERIFY=false

# ── Optional remote MCP HTTP mode ─────────────────────────────────────────
# Required by `npm run start:http`; never expose this endpoint without a token.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_TOKEN=replace-with-a-long-random-token

# Only for the cloudflared service in compose.example.yml, which runs under the
# `cloudflare` profile.
CLOUDFLARE_TUNNEL_TOKEN=
