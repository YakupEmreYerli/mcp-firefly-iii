# Copy to .env and fill in the two required values. .env is git-ignored.

# ── Required ───────────────────────────────────────────────────────────────
# A bare domain is enough — https:// and /api/v1 are filled in. Give the full
# URL if yours sits behind a subpath, a custom port, or plain http.
FIREFLY_API_URL=your-firefly-instance.com
# Firefly III → Options → Profile → OAuth → "Create New Personal Access Token"
FIREFLY_API_TOKEN=your-token-here

# ── Optional ───────────────────────────────────────────────────────────────
# There is no permission setting here. A stdio client can do whatever its
# Firefly token can, so issue a read-only token if that is the limit you want;
# an OAuth client gets what the consent screen approved.
#
# Return results as MCP structuredContent instead of JSON in a text block.
# Only for clients that understand it; responses are large either way.
MCP_STRUCTURED_OUTPUT=false
# Only for a local instance with a self-signed certificate.
FIREFLY_DISABLE_SSL_VERIFY=false

# ── Remote HTTP mode ───────────────────────────────────────────────────────
# Required by `npm run start:http`. Never expose the port without auth.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_TOKEN=replace-with-a-long-random-token

# ── OAuth ──────────────────────────────────────────────────────────────────
# Only for HTTP mode, and only for clients that cannot hold a static token —
# Claude's web connector, ChatGPT. See docs/oauth.md.
#
# The address clients reach this server at. A token's audience is bound to it,
# so it must match exactly. No subpath: Firefly III owns /oauth/* on its own
# hostname, so this needs a separate one.
MCP_RESOURCE_URL=
# Set a password (12+ characters) to run the embedded authorization server,
# or list external issuers instead. The two are mutually exclusive.
MCP_AUTH_PASSWORD=
MCP_AUTHORIZATION_SERVERS=
# Where the embedded server keeps its key and clients. Losing it de-authorizes
# every client, so back this path with a volume in Docker.
MCP_AUTH_STATE_DIR=/data/firefly-mcp-auth

# Only for the cloudflared service in compose.example.yml (`cloudflare` profile).
CLOUDFLARE_TUNNEL_TOKEN=
