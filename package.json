{
  "name": "@yakupemreyerli/firefly-mcp",
  "version": "1.1.2",
  "description": "Security-first, self-hosted MCP server for Firefly III — 152 operations behind 5 scoped tools, with stdio and authenticated HTTP.",
  "mcpName": "io.github.YakupEmreYerli/mcp-firefly-iii",
  "license": "MIT",
  "author": "Yakup Emre Yerli",
  "homepage": "https://github.com/YakupEmreYerli/mcp-firefly-iii#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YakupEmreYerli/mcp-firefly-iii.git"
  },
  "bugs": {
    "url": "https://github.com/YakupEmreYerli/mcp-firefly-iii/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "firefly-iii",
    "personal-finance",
    "llm"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "bin": {
    "firefly-mcp": "dist/index.js",
    "firefly-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.tr.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check": "node --env-file=.env dist/check.js",
    "start": "node --env-file=.env dist/index.js",
    "start:http": "node --env-file=.env dist/http.js",
    "prepublishOnly": "npm run typecheck && npm run build && npm test && npm run docs:check",
    "smoke:live": "npm run build && node --env-file=.env scripts/live-smoke.mjs",
    "docs:check": "npm run build && node scripts/docs/cli.mjs check",
    "docs:update": "npm run build && node scripts/docs/cli.mjs update",
    "media": "npm run build && node scripts/build-media.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "jose": "^6.2.10",
    "undici": "^7.0.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
